# Dockerfile.chat

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy project
COPY . .

# 🔥 Chat worker
CMD ["celery", "-A", "seekClarity_backend", "worker", "-Q", "chat_processing", "--concurrency=2", "--loglevel=info"]