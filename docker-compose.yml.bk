version: '3.9'

services:
  # backend:
  #   build:
  #     context: .
  #     dockerfile: Dockerfile.backend
  #   container_name: ats_backend
  #   restart: always
  #   ports:
  #     - "8000:8000"
  #   env_file:
  #     - .env
  #   depends_on:
  #     - db
  #     - minio

  db:
    image: postgres:15
    container_name: ats_postgres
    restart: always
    environment:
      POSTGRES_DB: seek_clarity_db
      POSTGRES_USER: seek_clarity_user
      POSTGRES_PASSWORD: seek_clarity_password
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data

  minio:
    image: minio/minio
    container_name: ats_minio
    restart: always
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: seek_clarity_admin
      MINIO_ROOT_PASSWORD: seek_clarity_admin
    ports:
      - "9000:9000"
      - "9001:9001"
    volumes:
      - minio_data:/data
  # pgadmin:
  #     image: dpage/pgadmin4
  #     container_name: ats_pgadmin
  #     restart: always
  #     environment:
  #       PGADMIN_DEFAULT_EMAIL: admin@admin.com
  #       PGADMIN_DEFAULT_PASSWORD: admin
  #     ports:
  #       - "5050:80"
  #     depends_on:
  #       - db
  qdrant:
    image: qdrant/qdrant:latest
    container_name: ats_qdrant
    restart: always
    ports:
      - "6333:6333"
      - "6334:6334"
    volumes:
      - qdrant_data:/qdrant/storage
    environment:
      QDRANT__SERVICE__ENABLE_UI: "true"

  rabbitmq:
    image: rabbitmq:3-management
    container_name: ats_rabbitmq
    restart: always
    ports:
      - "5672:5672"
      - "15672:15672"
    environment:
      RABBITMQ_DEFAULT_USER: seek_clarity_admin
      RABBITMQ_DEFAULT_PASS: seek_clarity_admin


    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  celery_processing:
    build:
      context: .
      dockerfile: Dockerfile.processing
    container_name: ats_celery_processing
    command: celery -A seekClarity_backend worker -Q document_processing --concurrency=2 --loglevel=info
    restart: always
    depends_on:
      - rabbitmq
      - db
    env_file:
      - .env
    environment:
      - RABBITMQ_HOST=rabbitmq
      - POSTGRES_HOST=db
      - MINIO_ENDPOINT=minio:9000
    volumes:
      - .:/app
  celery_embedding:
    build:
      context: .
      dockerfile: Dockerfile.embedding
    container_name: ats_celery_embedding
    command: celery -A seekClarity_backend worker -Q embedding --concurrency=2 --loglevel=info
    restart: always
    depends_on:
      - rabbitmq
      - db
      - qdrant
    env_file:
      - .env
    environment:
      - RABBITMQ_HOST=rabbitmq
      - POSTGRES_HOST=db
      - MINIO_ENDPOINT=minio:9000
      - QDRANT_HOST=qdrant
    volumes:
      - .:/app

  celery_chat:
    build:
      context: .
      dockerfile: Dockerfile.chat
    container_name: ats_celery_chat
    command: celery -A seekClarity_backend worker -Q chat_processing --concurrency=2 --loglevel=info
    restart: always
    depends_on:
      - rabbitmq
      - db
    env_file:
      - .env
    environment:
      - RABBITMQ_HOST=rabbitmq
      - POSTGRES_HOST=db
    volumes:
      - .:/app

volumes:
  postgres_data:
  minio_data:
  qdrant_data: